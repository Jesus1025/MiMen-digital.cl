# Copia este archivo como .env y completa los valores. El .env nunca se sube a git.

FLASK_ENV=production
BASE_URL=https://menu.divergentstudio.cl
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=menu_digital

# Para crear las tablas: /api/init-db?token=<INIT_DB_TOKEN>. Déjalo vacío para desactivar la ruta.
INIT_DB_TOKEN=
# Clave del usuario superadmin al crearlo (mínimo 12 caracteres)
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL=

# Imágenes (opcional): cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Cobros (opcional)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_WEBHOOK_KEY=

# Correo (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Monitoreo (opcional)
SENTRY_DSN=
# Solo PythonAnywhere free tier
API_PROXY=
